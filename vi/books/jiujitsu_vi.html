<script>

// theme
var themeBtn = document.getElementById('theme-toggle');
var savedTheme = localStorage.getItem('jj-theme');
if (savedTheme === 'dark') { document.documentElement.setAttribute('data-theme','dark'); themeBtn.innerHTML = '<i class="fa-solid fa-sun"></i>'; }
themeBtn.addEventListener('click', function(){
  var d = document.documentElement.getAttribute('data-theme') === 'dark';
  if (d) { document.documentElement.removeAttribute('data-theme'); localStorage.setItem('jj-theme','light'); this.innerHTML = '<i class="fa-solid fa-moon"></i>'; }
  else { document.documentElement.setAttribute('data-theme','dark'); localStorage.setItem('jj-theme','dark'); this.innerHTML = '<i class="fa-solid fa-sun"></i>'; }
});
// font size
var fs = parseInt(localStorage.getItem('jj-fs') || '17');
function applyFs(){ document.querySelector('.book-content').style.fontSize = fs + 'px'; }
applyFs();
document.getElementById('font-up').addEventListener('click', function(){ fs = Math.min(24, fs+1); localStorage.setItem('jj-fs', fs); applyFs(); });
document.getElementById('font-down').addEventListener('click', function(){ fs = Math.max(13, fs-1); localStorage.setItem('jj-fs', fs); applyFs(); });
// progress
window.addEventListener('scroll', function(){
  var h = document.documentElement.scrollHeight - window.innerHeight;
  var p = h > 0 ? (window.scrollY / h) * 100 : 0;
  document.getElementById('progress-bar').style.width = p + '%';
});
// TOC active
var links = document.querySelectorAll('.toc-nav a');
var sections = document.querySelectorAll('section.chapter');
window.addEventListener('scroll', function(){
  var pos = window.scrollY + 120;
  sections.forEach(function(sec){
    if (sec.offsetTop <= pos && sec.offsetTop + sec.offsetHeight > pos) {
      links.forEach(function(l){ l.classList.remove('active'); });
      var al = document.querySelector('.toc-nav a[href="#' + sec.id + '"]');
      if (al) al.classList.add('active');
    }
  });
});
</script>


