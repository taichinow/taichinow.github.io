          <tr><td>1</td><td>Khởi thức</td><td>10</td><td>Tay trong mây (tấn mã bộ)</td></tr>
          <tr><td>2</td><td>Mở ngực</td><td>11</td><td>Múc biển (và ngắm trời)</td></tr>
          <tr><td>3</td><td>Vẽ cầu vồng</td><td>12</td><td>Đẩy sóng</td></tr>
          <tr><td>4</td><td>Rẽ mây</td><td>13</td><td>Bồ câu bay (xòe cánh)</td></tr>
          <tr><td>5</td><td>Lăn tay (tấn cố định)</td><td>14</td><td>Xung quyền (duỗi tay)</td></tr>
          <tr><td>6</td><td>Chèo thuyền (giữa hồ)</td><td>15</td><td>Nhạn bay</td></tr>
          <tr><td>7</td><td>Nâng bóng</td><td>16</td><td>Quay bánh xe</td></tr>
          <tr><td>8</td><td>Ngắm trăng</td><td>17</td><td>Dội bóng (vừa bước)</td></tr>
          <tr><td>9</td><td>Xoay eo &amp; đẩy chưởng</td><td>18</td><td>An Khí (Calming Qi)</td></tr>
        </tbody>
