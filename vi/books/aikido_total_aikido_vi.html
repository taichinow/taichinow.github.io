<article class="srcpage" id="p74"><div class="pgmark">tr. 77</div>
<figure class="fig"><img src="https://raw.githubusercontent.com/taichinow/taichinow-media/main/assets/books/aikido_total_aikido_vi/img/p074_f03.jpg" alt="" loading="lazy" decoding="async"></figure>
