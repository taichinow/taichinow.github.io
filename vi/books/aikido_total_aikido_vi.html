<article class="srcpage" id="p160"><div class="pgmark">tr. 163</div>
<figure class="fig"><img src="https://raw.githubusercontent.com/taichinow/taichinow-media/main/assets/books/aikido_total_aikido_vi/img/p160_f01.jpg" alt="" loading="lazy" decoding="async"></figure>
