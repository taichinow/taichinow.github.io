<article class="srcpage" id="p109"><div class="pgmark">tr. 112</div>
<h3 class="run-in">YOKOMEN-UCHI SANKAJO OSAE NI | ĐÒN CHÉM NGANG VÀO ĐẦU: KHÓA THỨ BA II</h3>
<figure class="fig"><img src="https://raw.githubusercontent.com/taichinow/taichinow-media/main/assets/books/aikido_total_aikido_vi/img/p109_f02.jpg" alt="" loading="lazy" decoding="async"></figure>
<figure class="fig"><img src="https://raw.githubusercontent.com/taichinow/taichinow-media/main/assets/books/aikido_total_aikido_vi/img/p109_f03.jpg" alt="" loading="lazy" decoding="async"></figure>
<figure class="fig"><img src="https://raw.githubusercontent.com/taichinow/taichinow-media/main/assets/books/aikido_total_aikido_vi/img/p109_f04.jpg" alt="" loading="lazy" decoding="async"></figure>
<figure class="fig"><img src="https://raw.githubusercontent.com/taichinow/taichinow-media/main/assets/books/aikido_total_aikido_vi/img/p109_f01.jpg" alt="" loading="lazy" decoding="async"></figure>
<figure class="fig"><img src="https://raw.githubusercontent.com/taichinow/taichinow-media/main/assets/books/aikido_total_aikido_vi/img/p109_f05.jpg" alt="" loading="lazy" decoding="async"></figure>
<figure class="fig"><img src="https://raw.githubusercontent.com/taichinow/taichinow-media/main/assets/books/aikido_total_aikido_vi/img/p109_f06.jpg" alt="" loading="lazy" decoding="async"></figure>
