<div id="pdf-overlay" role="dialog" aria-modal="true" aria-label="Trình đọc PDF">
  <div class="pdf-toolbar">
    <span class="pdf-title"><i class="fa-solid fa-file-pdf"></i> <span id="pdf-title-text">Đọc bản in</span></span>
    <button class="pdf-btn" id="pdf-prev" title="Trang trước"><i class="fa-solid fa-chevron-up"></i></button>
    <span id="pdf-pageinfo" style="font-size:.85rem;min-width:88px;text-align:center;">&ndash; / &ndash;</span>
    <button class="pdf-btn" id="pdf-next" title="Trang sau"><i class="fa-solid fa-chevron-down"></i></button>
    <button class="pdf-btn" id="pdf-zoom-out" title="Thu nhỏ">A-</button>
    <button class="pdf-btn" id="pdf-zoom-in" title="Phóng to">A+</button>
    <a class="pdf-btn" id="pdf-download" href="#" download><i class="fa-solid fa-download"></i> Tải về</a>
    <button class="pdf-btn" id="pdf-close" title="Đóng (Esc)"><i class="fa-solid fa-xmark"></i> Đóng</button>
  </div>
  <div id="pdf-pages"></div>
  <div id="pdf-status">Đang tải…</div>
</div>

<script>
/* ==== Inline PDF viewer (shared component) ==== */
(function () {
  var overlay = document.getElementById('pdf-overlay');
  if (!overlay) return;
  var pagesEl  = document.getElementById('pdf-pages');
  var statusEl = document.getElementById('pdf-status');
  var infoEl   = document.getElementById('pdf-pageinfo');
  var dlLink   = document.getElementById('pdf-download');
  var dlAnchor = document.querySelector('.header-controls a[download]') ||
                 document.querySelector('a[href$=".pdf"]');
  var url = overlay.getAttribute('data-pdf') || (dlAnchor && dlAnchor.getAttribute('href'));
  if (!url) return;
  if (dlLink) dlLink.href = url;
  var titleEl = document.getElementById('pdf-title-text');
  if (titleEl) {
    var t = (document.title || '').split('\u00b7')[0].trim();
    titleEl.textContent = overlay.getAttribute('data-title') || t || '\u0110\u1ecdc b\u1ea3n in';
  }

  var PDFJS_BASE = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/';
  var libState = 0;                 /* 0 none, 1 loading, 2 ready, 3 failed */
  var pdfDoc = null, zoom = 1, items = [], current = 1, observer = null;
  var FAIL = 'Kh\u00f4ng t\u1ea3i \u0111\u01b0\u1ee3c tr\u00ecnh \u0111\u1ecdc PDF. H\u00e3y d\u00f9ng n\u00fat \u201cT\u1ea3i v\u1ec1\u201d.';

  function setStatus(msg) {
    if (!statusEl) return;
    if (msg) { statusEl.textContent = msg; statusEl.style.display = 'block'; }
    else { statusEl.style.display = 'none'; }
  }

  function loadLib(cb) {
    if (libState === 2) return cb();
    if (libState === 3) { setStatus(FAIL); return; }
    if (libState === 1) {
      var t = setInterval(function () {
        if (libState === 1) return;
        clearInterval(t);
        if (libState === 2) cb(); else setStatus(FAIL);
      }, 80);
      return;
    }
    libState = 1;
    var s = document.createElement('script');
    s.src = PDFJS_BASE + 'pdf.min.js';
    s.onload = function () {
      try { window.pdfjsLib.GlobalWorkerOptions.workerSrc = PDFJS_BASE + 'pdf.worker.min.js'; } catch (e) {}
      libState = 2; cb();
    };
    s.onerror = function () { libState = 3; setStatus(FAIL); };
    document.head.appendChild(s);
  }

  function fit() {
    var avail = pagesEl.clientWidth - 28;
    if (!avail || avail < 100) avail = 640;
    return Math.max(0.35, Math.min(avail / 420, 1.7));   /* A5 width ~= 420pt */
  }

  function draw(it) {
    if (!it || it.done || it.busy) return;
    it.busy = true;
    it.page.render({ canvasContext: it.canvas.getContext('2d'),
                     viewport: it.page.getViewport({ scale: it.scale }) }).promise
      .then(function () { it.done = true; it.busy = false; })
      .catch(function () { it.busy = false; });
  }

  /* the counter follows the scroll position, not the pre-render margin */
  function updateCurrent() {
    if (!items.length) return;
    var top = pagesEl.scrollTop + 20, best = 1, bd = Infinity;
    for (var i = 0; i < items.length; i++) {
      var d = Math.abs(items[i].canvas.offsetTop - top);
      if (d < bd) { bd = d; best = items[i].n; }
    }
    if (best !== current) {
      current = best;
      infoEl.textContent = current + ' / ' + pdfDoc.numPages;
    }
  }

  function observe() {
    if (observer) observer.disconnect();
    if (!('IntersectionObserver' in window)) { items.forEach(draw); return; }
    observer = new IntersectionObserver(function (es) {
      es.forEach(function (e) {
        if (!e.isIntersecting) return;
        var n = +e.target.dataset.page;
        draw(items[n - 1]);
        if (items[n]) draw(items[n]);          /* pre-render next */
      });
    }, { root: pagesEl, rootMargin: '700px 0px' });
    items.forEach(function (it) { observer.observe(it.canvas); });
  }

  function build() {
    pagesEl.innerHTML = '';
    items = []; current = 1;
    setStatus('\u0110ang d\u1ef1ng trang\u2026');
    var chain = Promise.resolve();
    for (var i = 1; i <= pdfDoc.numPages; i++) {
      (function (n) {
        chain = chain.then(function () {
          return pdfDoc.getPage(n).then(function (page) {
            var s = fit() * zoom;
            var vp = page.getViewport({ scale: s });
            var cv = document.createElement('canvas');
            cv.className = 'pdf-page';
            cv.dataset.page = n;
            cv.width = Math.floor(vp.width);
            cv.height = Math.floor(vp.height);
            cv.style.width = Math.floor(vp.width) + 'px';
            cv.style.height = Math.floor(vp.height) + 'px';
            pagesEl.appendChild(cv);
            items.push({ n: n, canvas: cv, page: page, scale: s, done: false, busy: false });
          });
        });
      })(i);
    }
    chain.then(function () {
      setStatus(null);
      infoEl.textContent = '1 / ' + pdfDoc.numPages;
      observe();
      updateCurrent();
    }).catch(function (e) { setStatus('L\u1ed7i: ' + (e && e.message ? e.message : e)); });
  }

  function goto(n) {
    if (!pdfDoc) return;
    n = Math.max(1, Math.min(pdfDoc.numPages, n));
    var it = items[n - 1];
    if (it) { pagesEl.scrollTop = it.canvas.offsetTop - 12; current = n; infoEl.textContent = n + ' / ' + pdfDoc.numPages; }
  }

  function refit() {
    if (!pdfDoc || !items.length) return;
    var s = fit() * zoom;
    items.forEach(function (it) {
      var vp = it.page.getViewport({ scale: s });
      it.scale = s; it.done = false;
      it.canvas.width = Math.floor(vp.width);
      it.canvas.height = Math.floor(vp.height);
      it.canvas.style.width = Math.floor(vp.width) + 'px';
      it.canvas.style.height = Math.floor(vp.height) + 'px';
    });
    var pr = pagesEl.getBoundingClientRect();
    items.forEach(function (it) {
      var r = it.canvas.getBoundingClientRect();
      if (r.bottom > pr.top - 700 && r.top < pr.bottom + 700) draw(it);
    });
  }

  function open() {
    overlay.classList.add('open');
    document.body.classList.add('pdf-lock');
    if (pdfDoc) return;
    setStatus('\u0110ang t\u1ea3i t\u00e0i li\u1ec7u\u2026');
    loadLib(function () {
      window.pdfjsLib.getDocument(url).promise
        .then(function (d) { pdfDoc = d; build(); })
        .catch(function (e) { setStatus('Kh\u00f4ng m\u1edf \u0111\u01b0\u1ee3c PDF: ' + (e && e.message ? e.message : e)); });
    });
  }
  function close() {
    overlay.classList.remove('open');
    document.body.classList.remove('pdf-lock');
  }

  var openBtn = document.getElementById('pdf-open');
  if (openBtn) openBtn.addEventListener('click', function (e) { e.preventDefault(); open(); });
  var bind = function (id, fn) { var el = document.getElementById(id); if (el) el.addEventListener('click', fn); };
  bind('pdf-close', close);
  bind('pdf-prev', function () { goto(current - 1); });
  bind('pdf-next', function () { goto(current + 1); });
  bind('pdf-zoom-in', function () { zoom = Math.min(3, zoom + 0.2); refit(); });
  bind('pdf-zoom-out', function () { zoom = Math.max(0.4, zoom - 0.2); refit(); });
  document.addEventListener('keydown', function (e) {
    if (!overlay.classList.contains('open')) return;
    if (e.key === 'Escape') close();
    else if (e.key === 'PageDown') goto(current + 1);
    else if (e.key === 'PageUp') goto(current - 1);
  });
  var st = false;
  pagesEl.addEventListener('scroll', function () {
    if (st) return;
    st = true;
    requestAnimationFrame(function () { st = false; updateCurrent(); });
  });
  var rt;
  window.addEventListener('resize', function () {
    if (!overlay.classList.contains('open')) return;
    clearTimeout(rt); rt = setTimeout(refit, 220);
  });
})();
</script>
</body>
