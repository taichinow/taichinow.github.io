# Normalize line endings for the whole repo so the two mirrors stay byte-identical.
# Text files are stored with LF in the object database; checkout uses the
# platform default (CRLF on Windows). Binary assets are never converted.
* text=auto eol=lf

# Explicit binary types (never touch line endings)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.eot  binary
*.mp4  binary
*.mp3  binary
*.webm binary
